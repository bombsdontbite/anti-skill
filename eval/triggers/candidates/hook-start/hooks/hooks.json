{
  "description": "One routing sentence for anti-skill's two skills, added at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.txt 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
