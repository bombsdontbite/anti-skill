        "parse_duration": {"role": "decoy",
          "where": [{"file": "app.py", "func": "parse_duration"}],
          "keywords": ["parse_duration", "duration"]},
        "load_orders": {"role": "other",
          "where": [{"file": "app.py", "func": "load_orders"}],
          "keywords": ["load_orders", "dictreader", "csv"]}
      }
    },
    "t03": {
      "kind": "allocation",
      "entry": "app.py", "args": ["events.jsonl"],
      "gen": [], "gen_tiny": ["--events", "400"],
      "components": {
        "snapshot": {"role": "hot",
          "where": [{"file": "app.py", "func": "snapshot"}],
          "keywords": ["snapshot", "deepcopy", "deep copy", "copy.deepcopy", "audit trail"]},
        "classify": {"role": "decoy",
          "where": [{"file": "app.py", "func": "classify"}, {"file": "app.py", "text": "EVENT_TYPE = re.compile"}],
          "keywords": ["classify", "event_type", "regex", "re.match", ".match"]},
        "load_events": {"role": "other",
          "where": [{"file": "app.py", "func": "load_events"}],
          "keywords": ["load_events", "json.loads", "json"]}
