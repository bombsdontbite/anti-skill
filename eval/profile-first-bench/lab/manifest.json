    "t01": {
      "kind": "import-time",
      "entry": "app.py", "args": ["queries.txt"],
      "gen": [], "gen_tiny": ["--queries", "200"],
      "components": {
        "spelling_import": {"role": "hot",
          "where": [{"file": "spelling.py"}, {"file": "app.py", "text": "import spelling"}],
          "keywords": ["spelling.py", "import spelling", "_build_variants", "_edits1", "variants", "import time", "import-time", "startup", "start-up", "module load", "vocab"]},
        "confusion_cube": {"role": "decoy",
          "where": [{"file": "app.py", "func": "confusion_cube"}],
          "keywords": ["confusion_cube", "cube", "triple"]},
        "correct_queries": {"role": "other",
          "where": [{"file": "app.py", "func": "correct_queries"}, {"file": "spelling.py", "func": "correct"}],
          "keywords": ["correct_queries", "spelling.correct"]}
      }
    },
    "t02": {
      "kind": "serialisation",
      "entry": "app.py", "args": ["orders.csv"],
      "gen": [], "gen_tiny": ["--orders", "300"],
      "components": {
        "write_report": {"role": "hot",
